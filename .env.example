ORCHESTRATOR_APP_NAME=A2A Orchestrator
ORCHESTRATOR_ENVIRONMENT=local
ORCHESTRATOR_LOG_LEVEL=INFO
ORCHESTRATOR_API_PREFIX=/api/v1
ORCHESTRATOR_DATABASE_PATH=.data/orchestrator.sqlite3
ORCHESTRATOR_WORKSPACE_ROOT=.data/workspaces
# Step 20: only an explicit POST /runs/{runId}/workspace/provision creates folders.
# This is a trusted server base, never an Agent/Model Tool path input.
# Existing registry roots must match this base; no automatic relocation/adoption.
# Agent Card base URLs. Planner URL enables automatic Run dispatch.
# ORCHESTRATOR_PLANNER_AGENT_URL=http://127.0.0.1:8101
# ORCHESTRATOR_DEVELOPER_AGENT_URL=http://127.0.0.1:8102
# ORCHESTRATOR_QA_AGENT_URL=http://127.0.0.1:8103
# ORCHESTRATOR_SECURITY_AGENT_URL=http://127.0.0.1:8104
# Credentials stay in ignored .env/process environment and HTTP headers.
# Do not put real passwords/tokens in requestText, inputData, or Artifacts.
# ORCHESTRATOR_PLANNER_BEARER_TOKEN=
# ORCHESTRATOR_DEVELOPER_BEARER_TOKEN=
# ORCHESTRATOR_QA_BEARER_TOKEN=
# ORCHESTRATOR_SECURITY_BEARER_TOKEN=

# Steps 17-19: Task storage and standalone LLM engine exist.
# Role executors/MCP are not wired; A2A servers still reject product execution.
# Each Agent process must select ONE role: PLANNER / DEVELOPER / QA / SECURITY.
# Use process environment for simultaneous roles instead of changing one .env.
# AGENT_ROLE=PLANNER
# AGENT_HOST=127.0.0.1
# AGENT_PORT=8101
# If AGENT_PORT is omitted: PLANNER=8101, DEVELOPER=8102, QA=8103, SECURITY=8104.
# AGENT_ENVIRONMENT=local
# AGENT_LOG_LEVEL=INFO
# Optional trusted operator path; default .data/agents/{role-lowercase}.sqlite3.
# ONE Agent process per DB. Never share with Orchestrator or the product DB.
# AGENT_DATABASE_PATH=.data/agents/planner.sqlite3
# Use an operator-issued token matching this role's ORCHESTRATOR_*_BEARER_TOKEN.
# AGENT_BEARER_TOKEN=
# Model selection starts unset. Leave unconfigured values commented/omitted,
# not active empty strings. Optional adapter: openai (no provider/model default).
# AGENT_LLM_PROVIDER=
# AGENT_LLM_MODEL_ID=
# AGENT_LLM_MODEL_REVISION=
# Temperature must be selected explicitly; unsupported options fail without fallback.
# AGENT_LLM_TEMPERATURE=
# Responses does not support seed; leave it unset with the openai adapter.
# AGENT_LLM_SEED=
# AGENT_LLM_API_KEY=
# Trusted limits; defaults shown, not Code Fix/MCP Retry limits.
# AGENT_LLM_LIMITS={"max_model_calls":8,"max_tool_calls":20,"max_output_tokens":2048,"model_timeout_seconds":60,"tool_timeout_seconds":60,"max_json_bytes":1048576}
# max_total_tokens is optional and checked on returned usage, NOT a prepaid cost cap.
# The host supplies the shared wall-clock budget to ExecutionBudget.
# Frozen Run-wide/distributed enforcement and persisted Trace are later steps.

# Agent starts its own stdio MCP child process in step 23, not in step 15.
# Its trusted launcher must pass the SAME role; a model never chooses this role.
# MCP_ROLE=PLANNER
# MCP_ENVIRONMENT=local
# MCP_LOG_LEVEL=INFO
# MCP_TRANSPORT=stdio
# MCP_PROTOCOL_VERSION=2026-07-28
