ORCHESTRATOR_APP_NAME=A2A Orchestrator
ORCHESTRATOR_ENVIRONMENT=local
ORCHESTRATOR_LOG_LEVEL=INFO
ORCHESTRATOR_API_PREFIX=/api/v1
ORCHESTRATOR_DATABASE_PATH=.data/orchestrator.sqlite3
ORCHESTRATOR_WORKSPACE_ROOT=.data/workspaces
# Agent Card base URLs. Planner URL enables automatic Run dispatch.
# ORCHESTRATOR_PLANNER_AGENT_URL=http://127.0.0.1:8101
# ORCHESTRATOR_DEVELOPER_AGENT_URL=http://127.0.0.1:8102
# ORCHESTRATOR_QA_AGENT_URL=http://127.0.0.1:8103
# ORCHESTRATOR_SECURITY_AGENT_URL=http://127.0.0.1:8104
# Credentials stay in ignored .env/process environment and HTTP headers.
# Do not put real passwords/tokens in requestText, inputData, or Artifacts.
# ORCHESTRATOR_PLANNER_BEARER_TOKEN=
# ORCHESTRATOR_DEVELOPER_BEARER_TOKEN=
# ORCHESTRATOR_QA_BEARER_TOKEN=
# ORCHESTRATOR_SECURITY_BEARER_TOKEN=
