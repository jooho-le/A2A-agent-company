{
  "schemaVersion": 1,
  "criteriaId": "urn:criteria:scn-001:security-static:0.1.0",
  "scenarioKey": "SCN-001",
  "analyzer": "evaluation.security.static_analysis",
  "checks": {"REQ-003": "SEC-SIGNUP-003", "REQ-005": "SEC-SIGNUP-001", "REQ-006": "SEC-SIGNUP-004"},
  "excludePathSegments": ["tests", "test"],
  "excludeFilePrefixes": ["test_"],
  "excludeFileNames": ["conftest.py"],
  "sensitiveNamePattern": "(?i)(pass(word|wd)?|pwd)",
  "nonSecretNameWords": ["length", "len", "min", "max", "count", "policy", "message", "msg", "error", "errors",
                         "field", "fields", "pattern", "regex", "rule", "rules", "label", "hint", "text",
                         "description", "strength", "required", "placeholder", "example", "validator",
                         "type", "name", "key", "header"],
  "hashPolicy": {
    "parameterRule": "AT_LEAST",
    "constructors": {
      "argon2.PasswordHasher": ["time_cost", "memory_cost", "parallelism", "hash_len", "salt_len", "encoding", "type"],
      "pwdlib.hashers.argon2.Argon2Hasher": ["time_cost", "memory_cost", "parallelism", "hash_len", "salt_len", "type"]
    },
    "libraryDefaults": {"time_cost": 3, "memory_cost": 65536, "parallelism": 4},
    "defaultFactories": ["pwdlib.PasswordHash.recommended"],
    "profiles": {
      "argon2.profiles.RFC_9106_LOW_MEMORY": {"time_cost": 3, "memory_cost": 65536, "parallelism": 4},
      "argon2.profiles.RFC_9106_HIGH_MEMORY": {"time_cost": 1, "memory_cost": 2097152, "parallelism": 4}
    },
    "argon2idTypes": ["argon2.Type.ID", "argon2.low_level.Type.ID"],
    "forbiddenHashCalls": ["hashlib.md5", "hashlib.sha1", "hashlib.sha224", "hashlib.sha256", "hashlib.sha384",
                           "hashlib.sha512", "hashlib.sha3_256", "hashlib.sha3_512", "hashlib.blake2b", "hashlib.new",
                           "hashlib.pbkdf2_hmac", "hashlib.scrypt", "base64.b64encode", "crypt.crypt"],
    "unapprovedHasherPrefixes": ["bcrypt.", "passlib.", "werkzeug.security.generate_password_hash", "hmac."],
    "storageFieldNames": ["password_hash", "hashed_password", "password_digest", "password"]
  },
  "duplicateEmail": {"emailNamePattern": "(?i)e-?mail", "requireUnique": true, "requireNormalization": ["strip", "lower"],
                   "excludedNameWords": ["token", "verified", "verification", "confirmed", "confirmation", "code",
                                         "sent", "otp", "link", "template", "subject", "body", "log",
                                         "notification", "count", "status"]},
  "exposure": {
    "logMethods": ["debug", "info", "warning", "warn", "error", "exception", "critical", "log"],
    "outputCalls": ["print", "sys.stdout.write", "sys.stderr.write", "warnings.warn"],
    "routeMethods": ["get", "post", "put", "patch", "delete"],
    "requireValidationErrorFilter": true
  },
  "bandit": {"hardcodedPasswordRules": ["B105", "B106", "B107"], "insecureHashRules": ["B303", "B324"]}
}
