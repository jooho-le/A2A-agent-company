{
  "schemaVersion": 2,
  "suiteId": "urn:suite:scn-001:signup-protected",
  "suiteVersion": "0.2.0",
  "scenarioKey": "SCN-001",
  "toolName": "run_unit_tests",
  "sourceDirectory": "tests/signup",
  "sets": {
    "practice": {"QA": "practice_qa.PracticeQAChecks", "SECURITY": "practice_security.PracticeSecurityChecks"},
    "pilot": {"QA": "exam_pilot.PilotExam", "SECURITY": "exam_pilot.PilotExam"},
    "final": {"QA": "exam_final.FinalExam", "SECURITY": "exam_final.FinalExam"}
  },
  "scopes": {
    "in-loop-qa": {
      "set": "practice", "role": "QA", "selector": "protected-signup-qa", "pattern": "practice_qa.py",
      "files": ["tests/signup/signup_link.py", "tests/signup/signup_qa_checks.py", "tests/signup/practice_qa.py"]
    },
    "in-loop-security": {
      "set": "practice", "role": "SECURITY", "selector": "protected-signup-security", "pattern": "practice_security.py",
      "files": ["tests/signup/signup_link.py", "tests/signup/signup_security_checks.py",
                "tests/signup/practice_security.py"]
    },
    "practice": {
      "set": "practice", "selector": "practice-signup", "pattern": "practice_*.py",
      "files": ["tests/signup/signup_link.py", "tests/signup/signup_qa_checks.py",
                "tests/signup/signup_security_checks.py", "tests/signup/practice_qa.py",
                "tests/signup/practice_security.py"]
    },
    "pilot": {
      "set": "pilot", "selector": "pilot-signup", "pattern": "exam_pilot.py",
      "files": ["tests/signup/signup_link.py", "tests/signup/signup_qa_checks.py",
                "tests/signup/signup_security_checks.py", "tests/signup/exam_pilot.py"]
    },
    "final": {
      "set": "final", "selector": "final-signup", "pattern": "exam_final.py",
      "files": ["tests/signup/signup_link.py", "tests/signup/signup_qa_checks.py",
                "tests/signup/signup_security_checks.py", "tests/signup/exam_final.py"]
    }
  },
  "checks": [
    {"key": "QA-SIGNUP-001", "checkId": "28f5b695-2d40-4c9d-acb2-7ef682cfacf8", "requirementKey": "REQ-001",
     "perspective": "QA", "method": "test_qa_signup_001_valid_signup_creates_user",
     "title": "유효한 이메일·비밀번호로 가입",
     "expectedResult": "유효한 가입마다 성공 응답(2xx)과 사용자 1명 생성"},
    {"key": "QA-SIGNUP-002", "checkId": "dbc502d9-5e40-4a03-9ea1-a38924a3a2ce", "requirementKey": "REQ-002",
     "perspective": "QA", "method": "test_qa_signup_002_invalid_email_is_rejected",
     "title": "형식 오류 이메일 거부",
     "expectedResult": "빈 값·@ 없음·로컬 없음·도메인 없음·@ 두 개·공백 포함 이메일이 모두 4xx 응답, 사용자 수 변화 없음"},
    {"key": "QA-SIGNUP-003", "checkId": "d15c2dfa-81ec-4d71-873f-a87ec68c77fb", "requirementKey": "REQ-003",
     "perspective": "QA", "method": "test_qa_signup_003_same_canonical_email_is_rejected",
     "title": "같은 canonical 이메일 중복 가입 방지",
     "expectedResult": "가입한 이메일을 같게·대소문자·앞뒤 공백으로 바꾼 재가입이 모두 4xx 응답이고 사용자 1명 유지"},
    {"key": "QA-SIGNUP-004", "checkId": "720c082c-a1f5-4147-ad53-14a27a60deaf", "requirementKey": "REQ-004",
     "perspective": "QA", "method": "test_qa_signup_004_password_minimum_length_is_eight",
     "title": "비밀번호 최소 8자",
     "expectedResult": "7자 이하는 4xx 응답·미생성, 8자 이상은 성공 응답·1명 생성"},
    {"key": "QA-SIGNUP-005", "checkId": "cc579a2d-11d4-4d79-b4a5-169a99ef90b3", "requirementKey": "REQ-003",
