{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2a-agent-company.local/schemas/project/independent_evaluation.schema.json",
  "title": "Independent Evaluation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "reportType", "evaluationId", "sourceRunId", "architecture", "createdAt",
    "suite", "expectedManifest", "observedManifest", "evaluationVerdict", "manifestCheck",
    "summary", "confirmedFailureIds", "unverifiedTestIds", "optionalConfirmedFailureIds",
    "optionalUnverifiedTestIds", "requiredCheckPassRate", "requiredRequirementPassRate",
    "requirements", "perspectives", "checks"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "reportType": {"const": "INDEPENDENT_EVALUATION"},
    "evaluationId": {"$ref": "#/$defs/uuid"},
    "sourceRunId": {"$ref": "#/$defs/uuid"},
    "architecture": {"enum": ["SINGLE_AGENT", "MULTI_AGENT"]},
    "createdAt": {"type": "string", "format": "date-time"},
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "expectedManifest": {"$ref": "https://a2a-agent-company.local/schemas/project/execution_manifest.schema.json"},
    "observedManifest": {
      "oneOf": [
        {"$ref": "https://a2a-agent-company.local/schemas/project/execution_manifest.schema.json"},
        {"type": "null"}
      ]
    },
    "evaluationVerdict": {"$ref": "#/$defs/verdict"},
    "manifestCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["errorCode", "mismatchedFields", "metadataMatches"],
      "properties": {
        "errorCode": {"enum": [null, "MANIFEST_MISSING", "MANIFEST_MISMATCH"]},
        "mismatchedFields": {"type": "array", "items": {"type": "string"}},
        "metadataMatches": {"type": "boolean"}
      }
    },
    "summary": {"$ref": "#/$defs/counts"},
    "confirmedFailureIds": {"$ref": "#/$defs/uuidList"},
    "unverifiedTestIds": {"$ref": "#/$defs/uuidList"},
    "optionalConfirmedFailureIds": {"$ref": "#/$defs/uuidList"},
    "optionalUnverifiedTestIds": {"$ref": "#/$defs/uuidList"},
    "requiredCheckPassRate": {"$ref": "#/$defs/rate"},
    "requiredRequirementPassRate": {"$ref": "#/$defs/rate"},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/group"},
          {
            "type": "object",
            "required": ["requirementId", "checkIds"],
            "properties": {
              "requirementId": {"$ref": "#/$defs/uuid"},
              "checkIds": {"$ref": "#/$defs/uuidList"}
            }
          }
        ]
      }
    },
    "perspectives": {
      "type": "object",
      "additionalProperties": false,
      "required": ["QA", "SECURITY"],
      "properties": {
        "QA": {"oneOf": [{"$ref": "#/$defs/group"}, {"type": "null"}]},
        "SECURITY": {"oneOf": [{"$ref": "#/$defs/group"}, {"type": "null"}]}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/check"}
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "uuidList": {"type": "array", "items": {"$ref": "#/$defs/uuid"}},
    "verdict": {"enum": ["PASS", "FAIL", "UNVERIFIED"]},
    "rate": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "null"}]},
    "statusCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "fail", "error", "notRun", "notApplicable"],
      "properties": {
        "pass": {"type": "integer", "minimum": 0},
        "fail": {"type": "integer", "minimum": 0},
        "error": {"type": "integer", "minimum": 0},
        "notRun": {"type": "integer", "minimum": 0},
        "notApplicable": {"type": "integer", "minimum": 0}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": {"$ref": "#/$defs/statusCounts"},
        "optional": {"$ref": "#/$defs/statusCounts"}
      }
    },
    "group": {
      "type": "object",
      "required": ["validationVerdict", "summary", "confirmedFailureIds", "unverifiedTestIds",
                   "optionalConfirmedFailureIds", "optionalUnverifiedTestIds", "requiredPassRate"],
      "properties": {
        "validationVerdict": {"$ref": "#/$defs/verdict"},
        "summary": {"$ref": "#/$defs/counts"},
        "confirmedFailureIds": {"$ref": "#/$defs/uuidList"},
        "unverifiedTestIds": {"$ref": "#/$defs/uuidList"},
        "optionalConfirmedFailureIds": {"$ref": "#/$defs/uuidList"},
        "optionalUnverifiedTestIds": {"$ref": "#/$defs/uuidList"},
        "requiredPassRate": {"$ref": "#/$defs/rate"}
      }
    },
    "nullableText": {"type": ["string", "null"]},
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["testId", "required", "status", "evidenceIds", "errorCode", "expectedResult",
                   "actualResult", "reason", "normalizedLocation", "exclusionApprovalRef",
                   "exclusionReason", "requirementId", "perspective", "title"],
      "properties": {
        "testId": {"$ref": "#/$defs/uuid"},
        "required": {"type": "boolean"},
        "status": {"enum": ["PASS", "FAIL", "ERROR", "NOT_RUN", "NOT_APPLICABLE"]},
        "evidenceIds": {"$ref": "#/$defs/uuidList"},
        "errorCode": {"$ref": "#/$defs/nullableText"},
        "expectedResult": {"$ref": "#/$defs/nullableText"},
        "actualResult": {"$ref": "#/$defs/nullableText"},
        "reason": {"$ref": "#/$defs/nullableText"},
        "normalizedLocation": {"$ref": "#/$defs/nullableText"},
        "exclusionApprovalRef": {"$ref": "#/$defs/nullableText"},
        "exclusionReason": {"$ref": "#/$defs/nullableText"},
        "requirementId": {"$ref": "#/$defs/uuid"},
        "perspective": {"enum": ["QA", "SECURITY"]},
        "title": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["PASS", "FAIL"]}}},
          "then": {"properties": {"evidenceIds": {"minItems": 1}}}
        }
      ]
    }
  }
}
