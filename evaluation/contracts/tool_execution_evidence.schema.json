{
  "$defs": {
    "ExecutionManifest": {
      "title": "SnapshotExecutionManifest",
      "description": "Immutable source and execution-environment identity attached to Build, QA, and Security results.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryId",
        "codeVersion",
        "projectArtifactId",
        "commitHash",
        "gitObjectFormat",
        "treeHash",
        "snapshotSha256",
        "containerImageDigest",
        "dependencyLockHash"
      ],
      "properties": {
        "repositoryId": {
          "type": "string",
          "minLength": 1
        },
        "codeVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "projectArtifactId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "commitHash": {
          "type": "string",
          "pattern": "^[0-9a-f]+$"
        },
        "gitObjectFormat": {
          "type": "string",
          "enum": [
            "sha1",
            "sha256"
          ]
        },
        "treeHash": {
          "type": "string",
          "pattern": "^[0-9a-f]+$"
        },
        "snapshotSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "containerImageDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "dependencyLockHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "gitObjectFormat": {
                "const": "sha1"
              }
            },
            "required": [
              "gitObjectFormat"
            ]
          },
          "then": {
            "properties": {
              "commitHash": {
                "pattern": "^[0-9a-f]{40}$"
              },
              "treeHash": {
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "gitObjectFormat": {
                "const": "sha256"
              }
            },
            "required": [
              "gitObjectFormat"
            ]
          },
          "then": {
            "properties": {
              "commitHash": {
                "pattern": "^[0-9a-f]{64}$"
              },
              "treeHash": {
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      ]
    },
    "GitObjectFormat": {
      "enum": [
        "sha1",
        "sha256"
      ],
      "title": "GitObjectFormat",
      "type": "string"
    },
    "ToolAttemptEvidence": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "maximum": 2,
          "minimum": 0,
          "title": "Attempt",
          "type": "integer"
        },
        "outcome": {
          "$ref": "#/$defs/ToolExecutionOutcome"
        },
        "evidenceRef": {
          "type": "string",
          "format": "uri",
          "minLength": 1,
          "pattern": "^(?!file:)[A-Za-z][A-Za-z0-9+.-]+:"
        },
        "errorKind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Errorkind"
        },
        "retrySafe": {
          "default": false,
          "title": "Retrysafe",
          "type": "boolean"
        },
        "durationMs": {
          "default": 0,
          "minimum": 0,
          "title": "Durationms",
          "type": "integer"
        }
      },
      "required": [
        "attempt",
        "outcome",
        "evidenceRef"
      ],
      "title": "ToolAttemptEvidence",
      "type": "object"
    },
    "ToolExecutionOutcome": {
      "enum": [
        "PASS",
        "FAIL",
        "UNVERIFIED"
      ],
      "title": "ToolExecutionOutcome",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "toolName": {
      "minLength": 1,
      "title": "Toolname",
      "type": "string"
    },
    "executionId": {
      "format": "uuid",
      "title": "Executionid",
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "executionManifest": {
      "$ref": "#/$defs/ExecutionManifest"
    },
    "evidenceRef": {
      "type": "string",
      "format": "uri",
      "minLength": 1,
      "pattern": "^(?!file:)[A-Za-z][A-Za-z0-9+.-]+:"
    },
    "attempts": {
      "items": {
        "$ref": "#/$defs/ToolAttemptEvidence"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Attempts",
      "type": "array"
    }
  },
  "required": [
    "toolName",
    "executionId",
    "executionManifest",
    "evidenceRef",
    "attempts"
  ],
  "title": "ToolExecutionEvidence",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2a-agent-company.local/schemas/project/tool_execution_evidence.schema.json"
}
