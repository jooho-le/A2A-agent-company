{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:a2a-agent-company:schema:planner-output:v1",
  "title": "Planner Output Contract",
  "description": "Project-level JSON contract for the Planner requirements.json A2A Artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requirements", "implementationPlan"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirement" }
    },
    "implementationPlan": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/implementationTask" }
    }
  },
  "$defs": {
    "uuid4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirementId", "key", "description", "acceptanceCriteria"],
      "properties": {
        "requirementId": { "$ref": "#/$defs/uuid4" },
        "key": { "type": "string", "pattern": "^REQ-[0-9]{3,}$" },
        "description": { "type": "string", "minLength": 1 },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "implementationTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "title", "description", "requirementIds"],
      "properties": {
        "taskId": { "type": "string", "pattern": "^TASK-[A-Z0-9_-]{1,64}$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "requirementIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/uuid4" }
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^TASK-[A-Z0-9_-]{1,64}$" }
        }
      }
    }
  }
}
