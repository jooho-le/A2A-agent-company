{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2a-agent-company.local/schemas/project/execution_manifest.schema.json",
  "title": "Build/QA/Security Execution Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["repositoryId", "codeVersion", "projectArtifactId", "commitHash", "gitObjectFormat", "treeHash", "snapshotSha256", "containerImageDigest", "dependencyLockHash"],
  "properties": {
    "repositoryId": { "type": "string", "minLength": 1 },
    "codeVersion": { "type": "integer", "minimum": 1, "maximum": 4 },
    "projectArtifactId": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "commitHash": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "gitObjectFormat": { "enum": ["sha1", "sha256"] },
    "treeHash": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "snapshotSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "containerImageDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "dependencyLockHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
