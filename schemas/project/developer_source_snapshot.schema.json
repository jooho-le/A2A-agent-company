{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2a-agent-company.local/schemas/project/developer_source_snapshot.schema.json",
  "title": "Developer Source Snapshot Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactId",
    "artifactType",
    "artifactVersion",
    "previousArtifactId",
    "runId",
    "workflowStepId",
    "a2aTaskId",
    "a2aArtifactId",
    "createdBy",
    "requirementIds",
    "codeVersion",
    "repositoryId",
    "commitHash",
    "gitObjectFormat",
    "treeHash",
    "snapshotSha256",
    "artifactUri",
    "containerImageDigest",
    "dependencyLockHash",
    "createdAt"
  ],
  "properties": {
    "artifactId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "artifactType": {
      "const": "SOURCE"
    },
    "artifactVersion": {
      "type": "integer",
      "minimum": 1
    },
    "previousArtifactId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "runId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "workflowStepId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "a2aTaskId": {
      "type": "string",
      "minLength": 1
    },
    "a2aArtifactId": {
      "type": "string",
      "minLength": 1
    },
    "createdBy": {
      "const": "DEVELOPER"
    },
    "requirementIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      }
    },
    "codeVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "repositoryId": {
      "type": "string",
      "minLength": 1
    },
    "commitHash": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "gitObjectFormat": {
      "enum": [
        "sha1",
        "sha256"
      ]
    },
    "treeHash": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "snapshotSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifactUri": {
      "type": "string",
      "minLength": 1
    },
    "containerImageDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "dependencyLockHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "gitObjectFormat": {
            "const": "sha1"
          }
        },
        "required": [
          "gitObjectFormat"
        ]
      },
      "then": {
        "properties": {
          "commitHash": {
            "pattern": "^[0-9a-f]{40}$"
          },
          "treeHash": {
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "gitObjectFormat": {
            "const": "sha256"
          }
        },
        "required": [
          "gitObjectFormat"
        ]
      },
      "then": {
        "properties": {
          "commitHash": {
            "pattern": "^[0-9a-f]{64}$"
          },
          "treeHash": {
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  ]
}
